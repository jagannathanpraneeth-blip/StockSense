{
  "name": "stocksense",
  "version": "0.1.0",
  "private": true,
  "description": "StockSense - Modular Inventory Management System for Odoo Hackathon",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:studio": "npm --prefix backend run prisma:studio",
    "seed": "npm --prefix backend run seed",
    "db:setup": "npm --prefix backend run db:setup",
    "start": "npm --prefix backend start",
    "db:upgrade": "npm --prefix backend run db:upgrade",
    "create:manager": "npm --prefix backend run create:manager",
    "test:review": "npm --prefix backend run test:review",
    "verify": "npm run build && npm run test:review"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "inventory",
    "management",
    "odoo",
    "stocksense"
  ],
  "author": "",
  "license": "UNLICENSED"
}
