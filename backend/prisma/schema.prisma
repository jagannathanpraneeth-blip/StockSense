// StockSense Prisma Schema
// Database specification for modular Inventory Management System (IMS)
// Quantity Precision Policy:
// All quantities are stored as Float with a 4-decimal place precision standard (0.0001).
// Business logic in src/utils/quantity.ts enforces rounding and validation to eliminate floating-point drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  role         String        @default("WAREHOUSE_STAFF") // ADMIN, INVENTORY_MANAGER, WAREHOUSE_STAFF
  passwordHash String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  operations   Operation[]   @relation("UserOperations")
  ledgerEntries StockLedger[] @relation("UserLedger")
}

model Warehouse {
  id          String     @id @default(uuid())
  name        String
  code        String     @unique
  address     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  locations   Location[]
}

model Location {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  isScrap     Boolean       @default(false)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stockBalances       StockBalance[]
  sourceOperations    Operation[]     @relation("SourceLocationOperations")
  destOperations      Operation[]     @relation("DestLocationOperations")
  sourceLines         OperationLine[] @relation("SourceLineLocations")
  destLines           OperationLine[] @relation("DestLineLocations")
  ledgerEntries       StockLedger[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id               String         @id @default(uuid())
  name             String
  sku              String         @unique
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  uom              String         @default("Units") // Units, kg, m, Box, Liters, etc.
  reorderThreshold Float          @default(0.0)
  description      String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  stockBalances    StockBalance[]
  operationLines   OperationLine[]
  ledgerEntries    StockLedger[]
}

model StockBalance {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantity   Float    @default(0.0)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
}

// Operation types: RECEIPT, DELIVERY, INTERNAL_TRANSFER, ADJUSTMENT
// Operation statuses: DRAFT, WAITING, READY, DONE, CANCELED
model Operation {
  id               String          @id @default(uuid())
  reference        String          @unique // e.g. WH/IN/0001
  type             String          // RECEIPT, DELIVERY, INTERNAL_TRANSFER, ADJUSTMENT
  status           String          @default("DRAFT") // DRAFT, WAITING, READY, DONE, CANCELED
  partner          String?         // Supplier for Receipt, Customer for Delivery
  sourceLocationId String?
  sourceLocation   Location?       @relation("SourceLocationOperations", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destLocationId   String?
  destLocation     Location?       @relation("DestLocationOperations", fields: [destLocationId], references: [id], onDelete: Restrict)
  notes            String?
  createdById      String?
  createdBy        User?           @relation("UserOperations", fields: [createdById], references: [id], onDelete: SetNull)
  validatedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  lines            OperationLine[]
  ledgerEntries    StockLedger[]
}

model OperationLine {
  id               String    @id @default(uuid())
  operationId      String
  operation        Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  demandQty        Float     @default(0.0)
  doneQty          Float     @default(0.0)
  sourceLocationId String?
  sourceLocation   Location? @relation("SourceLineLocations", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destLocationId   String?
  destLocation     Location? @relation("DestLineLocations", fields: [destLocationId], references: [id], onDelete: Restrict)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model StockLedger {
  id            String     @id @default(uuid())
  operationId   String?
  operation     Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId    String
  location      Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  deltaQty      Float      // Signed delta (+ incoming, - outgoing)
  balanceAfter  Float      // Snapshot balance at location after this delta
  referenceType String     // RECEIPT, DELIVERY, INTERNAL_TRANSFER, ADJUSTMENT, OPENING_STOCK
  referenceDoc  String     // e.g. WH/IN/0001 or INITIAL
  actorId       String?
  actor         User?      @relation("UserLedger", fields: [actorId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime   @default(now())
}
