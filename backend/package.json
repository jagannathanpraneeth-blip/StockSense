{
  "name": "stocksense-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StockSense Backend API Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "create:manager": "tsx src/scripts/create-manager.ts",
    "test:stage4": "node scripts/test-review.cjs",
    "db:setup": "prisma migrate dev --name init && tsx prisma/seed.ts",
    "db:upgrade": "node scripts/upgrade-db.cjs",
    "prisma:deploy": "prisma migrate deploy",
    "test:review": "node scripts/test-review.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "connect-sqlite3": "^0.9.18",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "nodemailer": "^10.0.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-sqlite3": "^0.9.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
