NODE_ENV=development
PORT=5000
DATABASE_URL="file:./dev.db"
CORS_ORIGIN="http://localhost:5173"
# Replace with a random secret before production; production rejects this example.
SESSION_SECRET="change-me-development-only-secret"
SESSION_MAX_AGE_MS=86400000
SESSION_DB_DIR="./"
SESSION_DB_NAME="sessions.sqlite"
TRUST_PROXY_HOPS=0
LOCAL_OTP_LOG=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense <noreply@example.com>"
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Optional only when running create:manager; never commit actual credentials.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_PASSWORD=
